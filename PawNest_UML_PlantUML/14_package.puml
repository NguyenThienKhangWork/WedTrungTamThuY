@startuml 14_package
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 14
skinparam ArrowColor #8A5A44
skinparam TitleFontSize 16
skinparam TitleFontColor #E5533D
skinparam usecase {
  BackgroundColor #FFF1E0
  BorderColor #E5533D
}
skinparam actor {
  BackgroundColor #FFE9B0
  BorderColor #4A2E24
}
skinparam class {
  BackgroundColor #FFF8EE
  BorderColor #E5533D
  HeaderBackgroundColor #FFE9B0
}
skinparam entity {
  BackgroundColor #FFF8EE
  BorderColor #E5533D
}
skinparam sequence {
  ParticipantBackgroundColor #FFE9B0
  ParticipantBorderColor #4A2E24
  LifeLineBorderColor #8A5A44
  ActorBackgroundColor #FFE9B0
  ActorBorderColor #4A2E24
}
skinparam state {
  BackgroundColor #FFF1E0
  BorderColor #E5533D
}
skinparam activity {
  BackgroundColor #FFF1E0
  BorderColor #E5533D
}
skinparam component {
  BackgroundColor #FFF1E0
  BorderColor #E5533D
}
skinparam node {
  BackgroundColor #FFF8EE
  BorderColor #8A5A44
}
skinparam package {
  BackgroundColor #FFFBF3
  BorderColor #8A5A44
}
skinparam database {
  BackgroundColor #FFE9B0
  BorderColor #8A5A44
}
skinparam rectangle {
  BackgroundColor #FFFBF3
  BorderColor #8A5A44
}
title Sơ đồ gói – Cấu trúc mã nguồn /pawnest
package "Trang công khai" as PUB {
  [index.php]
  [dich-vu.php]
  [bang-gia.php]
  [thu-vien.php]
  [dat-lich.php]
  [danh-gia.php]
  [lien-he.php]
}
package "assets" as AS {
  [css/style.css, clay.css]
  [js/main.js, booking.js]
  [img/]
}
package "api" as API {
  [services.php]
  [slots.php]
  [appointments.php]
  [reviews.php]
}
package "admin" as ADM {
  [login.php]
  [dashboard.php]
  [appointments.php ]
  [services.php ]
  [gallery.php]
  [reviews.php ]
}
package "includes" as INC {
  [config.php]
  [db.php]
  [auth.php]
  [functions.php]
  [header.php, footer.php]
}
package "database" as DBP {
  [schema.sql]
  [seed.sql]
}

PUB ..> INC : require
PUB ..> AS : liên kết CSS/JS/ảnh
AS ..> API : fetch (AJAX)
API ..> INC : require
ADM ..> INC : require
INC ..> DBP : kết nối CSDL
@enduml
