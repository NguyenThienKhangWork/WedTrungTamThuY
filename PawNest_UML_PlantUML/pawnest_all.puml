title Sơ đồ tuần tự – Lễ tân xử lý lịch hẹn
autonumber
actor "Lễ tân" as L
participant "admin/appointments.php" as P
participant "includes/auth.php" as Au
database "MySQL" as DB
participant "PHPMailer" as M
actor "Khách" as K

L -> P : Mở danh sách lịch chờ xác nhận
activate P
P -> Au : requireRole(receptionist, admin)
Au --> P : hợp lệ
P -> DB : SELECT appointments WHERE status = 'pending'
DB --> P : danh sách lịch
P --> L : Hiển thị danh sách
L -> P : Bấm Xác nhận / Đổi giờ / Hủy (POST + CSRF)
P -> Au : verifyCsrf(token)
Au --> P : hợp lệ
alt Xác nhận
  P -> DB : UPDATE status = 'confirmed'
  P -> M : Gửi tin xác nhận lịch
  M --> K : Email / Zalo xác nhận
else Đổi giờ
  P -> DB : Kiểm tra trùng giờ rồi UPDATE start_at
  P -> M : Gửi tin đổi lịch
  M --> K : Email / Zalo báo giờ mới
else Hủy
  P -> DB : UPDATE status = 'cancelled'
  P -> M : Gửi tin hủy lịch
  M --> K : Email / Zalo báo hủy
end
P -> DB : INSERT notifications (kết quả gửi)
P --> L : Thông báo kết quả
deactivate P
@enduml

