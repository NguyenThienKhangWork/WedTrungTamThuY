title Sơ đồ Use Case tổng quát – Website PawNest
left to right direction
actor "Khách / Chủ nuôi" as KH
actor "Nhân viên" as NV
actor "Lễ tân" as LT
actor "Bác sĩ / Groomer" as BS
actor "Quản lý" as QL
actor "Dịch vụ Email / Zalo" as MAIL <<hệ thống>>
LT --|> NV
BS --|> NV
QL --|> NV

rectangle "Website PawNest" {
  package "Trang công khai" {
    usecase "Xem trang chủ và giới thiệu" as UC1
    usecase "Xem dịch vụ và bảng giá" as UC2
    usecase "Xem thư viện bé cưng" as UC3
    usecase "Xem đánh giá" as UC4
    usecase "Xem liên hệ và bản đồ" as UC5
    usecase "Đặt lịch hẹn" as UC6
    usecase "Xem khung giờ trống" as UC7
    usecase "Gửi đánh giá" as UC8
    usecase "Đổi / hủy lịch hẹn" as UC9
  }
  package "Tài khoản khách (GĐ2)" {
    usecase "Đăng ký / đăng nhập" as UC10
    usecase "Quản lý hồ sơ thú cưng" as UC11
    usecase "Xem lịch sử chăm sóc" as UC12
  }
  package "Quản trị" {
    usecase "Đăng nhập quản trị" as UC20
    usecase "Xác nhận / đổi / hủy lịch" as UC21
    usecase "Ghi nhận khách đến, hoàn thành" as UC22
    usecase "Ghi chú tình trạng bé" as UC23
    usecase "Xem lịch làm việc cá nhân" as UC24
    usecase "Quản lý dịch vụ và giá" as UC25
    usecase "Quản lý thư viện ảnh" as UC26
    usecase "Duyệt đánh giá" as UC27
    usecase "Xem báo cáo" as UC28
    usecase "Quản lý nhân sự và tài khoản" as UC29
  }
  usecase "Gửi thông báo\n(email / Zalo)" as UC30
}

