title Sơ đồ hoạt động – Quy trình đặt lịch và chăm sóc
|Khách|
start
:Chọn dịch vụ / gói;
:Chọn ngày hẹn;
|Website|
:Tra khung giờ trống (AJAX);
|Khách|
repeat
  :Chọn giờ và điền thông tin\n(tên, SĐT, tên bé, loại thú cưng);
  |Website|
  :JavaScript kiểm tra dữ liệu;
  if (Dữ liệu hợp lệ?) then (không)
    :Hiện lỗi cụ thể;
  else (có)
    :Gửi yêu cầu đến PHP;
    :PHP kiểm tra lại và kiểm tra trùng giờ;
    if (Khung giờ còn trống?) then (có)
      :Lưu lịch hẹn (pending);
      :Gửi tin xác nhận đã nhận lịch;
    else (không)
      :Báo khung giờ đã có người đặt;
    endif
  endif
  |Khách|
repeat while (Chưa đặt được lịch?) is (đúng) not (đã xong)
:Nhận thông báo đã đặt lịch;
|Lễ tân|
:Xem lịch chờ xác nhận;
if (Xác nhận lịch?) then (có)
  :Chuyển sang confirmed;
  |Website|
  :Gửi xác nhận và nhắc lịch\ntrước 24 giờ và 2 giờ;
  |Khách|
  if (Khách đến đúng hẹn?) then (có)
    |Lễ tân|
    :Ghi nhận khách đến;
    |Bác sĩ / Groomer|
    :Thực hiện dịch vụ, ghi chú tình trạng bé;
    :Chuyển sang done;
    |Website|
    :Gửi lời cảm ơn và mời đánh giá;
  else (không)
    |Lễ tân|
    :Đánh dấu no_show;
  endif
else (không)
  :Hủy lịch (cancelled), gọi báo khách;
  |Website|
  :Gửi thông báo hủy;
endif
stop
@enduml

