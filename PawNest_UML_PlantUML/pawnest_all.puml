title Sơ đồ lớp – Miền nghiệp vụ (Domain)
hide empty members
enum AppointmentStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
  NO_SHOW
}
enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}
enum StaffRole {
  DOCTOR
  GROOMER
  RECEPTIONIST
}
enum UserRole {
  ADMIN
  RECEPTIONIST
  STAFF
}

class Customer {
  - id : int
  - fullName : string
  - phone : string
  - email : string
  - address : string
  - consentAt : datetime
  + register()
  + bookAppointment()
  + deleteMyData()
}
class Pet {
  - id : int
  - name : string
  - species : string
  - breed : string
  - birthDate : date
  - weightKg : float
  - note : string
}
class Service {
  - id : int
  - name : string
  - description : string
  - durationMin : int
  - price : decimal
  - isPackage : bool
  - isActive : bool
  + calcPrice(weightKg) : decimal
}
class Staff {
  - id : int
  - fullName : string
  - role : StaffRole
  - specialty : string
  - photo : string
  - isActive : bool
  + isFree(startAt, endAt) : bool
}
class Appointment {
  - id : int
  - startAt : datetime
  - endAt : datetime
  - status : AppointmentStatus
  - note : string
  - source : string
  + confirm()
  + reschedule(newStart)
  + cancel()
  + complete()
  + markNoShow()
}
class Review {
  - id : int
  - rating : int
  - content : string
  - status : ReviewStatus
  + approve()
  + hide()
}
class GalleryItem {
  - id : int
  - imageBefore : string
  - imageAfter : string
  - hasConsent : bool
  - isVisible : bool
}
class User {
  - id : int
  - username : string
  - passwordHash : string
  - role : UserRole
  - lastLoginAt : datetime
  + login()
  + logout()
  + hasRole(role) : bool
}
class Notification {
  - id : int
  - channel : string
  - type : string
  - sentAt : datetime
  - status : string
  + send()
}

Customer "1" --> "0..*" Pet : nuôi
Customer "1" --> "0..*" Appointment : đặt
Pet "1" --> "0..*" Appointment : được chăm sóc
Service "1" --> "0..*" Appointment : thuộc về
Staff "1" --> "0..*" Appointment : thực hiện
Appointment "1" --> "0..1" Review : nhận
Appointment "1" --> "0..*" Notification : phát sinh
Pet "1" --> "0..*" GalleryItem : có ảnh
User "0..1" -- "0..1" Staff : tài khoản của
Appointment ..> AppointmentStatus
Review ..> ReviewStatus
Staff ..> StaffRole
User ..> UserRole
@enduml

