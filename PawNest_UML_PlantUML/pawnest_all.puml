title Sơ đồ lớp – Tầng xử lý PHP (includes, api, repository)
hide empty members
package "includes" {
  class Database {
    - pdo : PDO
    + getConnection() : PDO
  }
  class Auth {
    + login(username, password) : bool
    + logout()
    + requireRole(roles)
    + csrfToken() : string
    + verifyCsrf(token) : bool
  }
  class Validator {
    + required(value) : bool
    + phone(value) : bool
    + futureDate(value) : bool
    + escape(text) : string
  }
  class Mailer {
    + send(to, subject, body) : bool
  }
}
package "repository" {
  class ServiceRepository {
    + findActive() : array
  }
  class SlotRepository {
    + freeSlots(date, serviceId) : array
  }
  class AppointmentRepository {
    + create(data) : int
    + updateStatus(id, status)
    + reschedule(id, newStart)
    + findByStatus(status) : array
  }
  class CustomerRepository {
    + findOrCreate(data) : int
  }
  class PetRepository {
    + findOrCreate(customerId, data) : int
  }
  class ReviewRepository {
    + create(data)
    + findApproved() : array
    + setStatus(id, status)
  }
}
package "api" {
  class ServicesApi
  class SlotsApi
  class AppointmentsApi {
    + handlePost()
  }
  class ReviewsApi
}
package "admin" {
  class AdminAppointments
  class AdminServices
  class AdminReviews
}

ServicesApi ..> ServiceRepository
SlotsApi ..> SlotRepository
AppointmentsApi ..> Validator
AppointmentsApi ..> Auth : CSRF
AppointmentsApi ..> CustomerRepository
AppointmentsApi ..> PetRepository
AppointmentsApi ..> AppointmentRepository
AppointmentsApi ..> Mailer
ReviewsApi ..> ReviewRepository
ReviewsApi ..> Validator
AdminAppointments ..> Auth
AdminAppointments ..> AppointmentRepository
AdminAppointments ..> Mailer
AdminServices ..> Auth
AdminServices ..> ServiceRepository
AdminReviews ..> Auth
AdminReviews ..> ReviewRepository
ServiceRepository ..> Database
SlotRepository ..> Database
AppointmentRepository ..> Database
CustomerRepository ..> Database
PetRepository ..> Database
ReviewRepository ..> Database
@enduml

