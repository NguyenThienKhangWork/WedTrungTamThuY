title Sơ đồ ER – Cơ sở dữ liệu MySQL (pawnest_db)
hide circle
skinparam linetype polyline
entity "customers" as customers {
  * id : INT <<PK>>
  --
  * full_name : VARCHAR(100)
  * phone : VARCHAR(15)
  email : VARCHAR(100)
  address : VARCHAR(255)
  consent_at : DATETIME
  created_at : DATETIME
}
entity "pets" as pets {
  * id : INT <<PK>>
  --
  * customer_id : INT <<FK>>
  * name : VARCHAR(60)
  * species : VARCHAR(30)
  breed : VARCHAR(60)
  birth_date : DATE
  weight_kg : DECIMAL(5,2)
  note : TEXT
}
entity "services" as services {
  * id : INT <<PK>>
  --
  * name : VARCHAR(100)
  description : TEXT
  * duration_min : INT
  * price : DECIMAL(12,0)
  * is_package : TINYINT(1)
  * is_active : TINYINT(1)
}
entity "staff" as staff {
  * id : INT <<PK>>
  --
  * full_name : VARCHAR(100)
  * role : ENUM
  specialty : VARCHAR(100)
  photo : VARCHAR(255)
  * is_active : TINYINT(1)
}
entity "appointments" as appointments {
  * id : INT <<PK>>
  --
  * customer_id : INT <<FK>>
  * pet_id : INT <<FK>>
  * service_id : INT <<FK>>
  * staff_id : INT <<FK>>
  * start_at : DATETIME
  * end_at : DATETIME
  * status : ENUM
  note : TEXT
  source : VARCHAR(20)
  created_at : DATETIME
  ..
  UNIQUE (staff_id, start_at)
}
entity "reviews" as reviews {
  * id : INT <<PK>>
  --
  * appointment_id : INT <<FK>> <<UNIQUE>>
  * rating : TINYINT
  content : TEXT
  * status : ENUM
  created_at : DATETIME
}
entity "gallery" as gallery {
  * id : INT <<PK>>
  --
  * pet_id : INT <<FK>>
  image_before : VARCHAR(255)
  image_after : VARCHAR(255)
  * has_consent : TINYINT(1)
  * is_visible : TINYINT(1)
}
entity "users" as users {
  * id : INT <<PK>>
  --
  staff_id : INT <<FK>>
  * username : VARCHAR(50) <<UNIQUE>>
  * password_hash : VARCHAR(255)
  * role : ENUM
  last_login_at : DATETIME
}
entity "notifications" as notifications {
  * id : INT <<PK>>
  --
  * appointment_id : INT <<FK>>
  * channel : VARCHAR(20)
  * type : VARCHAR(30)
  sent_at : DATETIME
  * status : VARCHAR(20)
}

