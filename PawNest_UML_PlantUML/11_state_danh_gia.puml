@startuml 11_state_danh_gia
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 14
skinparam ArrowColor #8A5A44
skinparam TitleFontSize 16
skinparam TitleFontColor #E5533D
skinparam usecase {
  BackgroundColor #FFF1E0
  BorderColor #E5533D
}
skinparam actor {
  BackgroundColor #FFE9B0
  BorderColor #4A2E24
}
skinparam class {
  BackgroundColor #FFF8EE
  BorderColor #E5533D
  HeaderBackgroundColor #FFE9B0
}
skinparam entity {
  BackgroundColor #FFF8EE
  BorderColor #E5533D
}
skinparam sequence {
  ParticipantBackgroundColor #FFE9B0
  ParticipantBorderColor #4A2E24
  LifeLineBorderColor #8A5A44
  ActorBackgroundColor #FFE9B0
  ActorBorderColor #4A2E24
}
skinparam state {
  BackgroundColor #FFF1E0
  BorderColor #E5533D
}
skinparam activity {
  BackgroundColor #FFF1E0
  BorderColor #E5533D
}
skinparam component {
  BackgroundColor #FFF1E0
  BorderColor #E5533D
}
skinparam node {
  BackgroundColor #FFF8EE
  BorderColor #8A5A44
}
skinparam package {
  BackgroundColor #FFFBF3
  BorderColor #8A5A44
}
skinparam database {
  BackgroundColor #FFE9B0
  BorderColor #8A5A44
}
skinparam rectangle {
  BackgroundColor #FFFBF3
  BorderColor #8A5A44
}
title Sơ đồ trạng thái – Đánh giá (Review)
hide empty description
[*] --> Pending : Khách gửi đánh giá
Pending --> Approved : Quản lý duyệt
Pending --> Hidden : Quản lý ẩn
Approved --> Hidden : Ẩn đánh giá
Hidden --> Approved : Hiển thị lại
Approved --> [*]
Hidden --> [*]

state Pending : Chờ duyệt
state Approved : Đang hiển thị trên website
state Hidden : Đã ẩn
@enduml
