UC6 ..> UC30 : <<include>>
UC9 ..> UC30 : <<include>>
UC21 ..> UC30 : <<include>>
UC11 ..> UC10 : <<include>>
UC12 ..> UC10 : <<include>>
NV --> UC20
LT --> UC21
LT --> UC22
BS --> UC23
BS --> UC24
QL --> UC25
QL --> UC26
QL --> UC27
QL --> UC28
QL --> UC29
