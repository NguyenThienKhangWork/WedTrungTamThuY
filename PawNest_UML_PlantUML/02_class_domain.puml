@startuml 02_class_domain
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 14
skinparam ArrowColor #8A5A44
skinparam TitleFontSize 16
skinparam TitleFontColor #E5533D
skinparam usecase {
  BackgroundColor #FFF1E0
  BorderColor #E5533D
}
skinparam actor {
  BackgroundColor #FFE9B0
  BorderColor #4A2E24
}
skinparam class {
  BackgroundColor #FFF8EE
  BorderColor #E5533D
  HeaderBackgroundColor #FFE9B0
}
skinparam entity {
  BackgroundColor #FFF8EE
  BorderColor #E5533D
}
skinparam sequence {
  ParticipantBackgroundColor #FFE9B0
  ParticipantBorderColor #4A2E24
  LifeLineBorderColor #8A5A44
  ActorBackgroundColor #FFE9B0
  ActorBorderColor #4A2E24
}
skinparam state {
  BackgroundColor #FFF1E0
  BorderColor #E5533D
}
skinparam activity {
  BackgroundColor #FFF1E0
  BorderColor #E5533D
}
skinparam component {
  BackgroundColor #FFF1E0
  BorderColor #E5533D
}
skinparam node {
  BackgroundColor #FFF8EE
  BorderColor #8A5A44
}
skinparam package {
  BackgroundColor #FFFBF3
  BorderColor #8A5A44
}
skinparam database {
  BackgroundColor #FFE9B0
  BorderColor #8A5A44
}
skinparam rectangle {
  BackgroundColor #FFFBF3
  BorderColor #8A5A44
}
title Sơ đồ lớp – Miền nghiệp vụ (Domain)
hide empty members
enum AppointmentStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
  NO_SHOW
}
enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}
enum StaffRole {
  DOCTOR
  GROOMER
  RECEPTIONIST
}
enum UserRole {
  ADMIN
  RECEPTIONIST
  STAFF
}

class Customer {
  - id : int
  - fullName : string
  - phone : string
  - email : string
  - address : string
  - consentAt : datetime
  + register()
  + bookAppointment()
  + deleteMyData()
}
class Pet {
  - id : int
  - name : string
  - species : string
  - breed : string
  - birthDate : date
  - weightKg : float
  - note : string
}
class Service {
  - id : int
  - name : string
  - description : string
  - durationMin : int
  - price : decimal
  - isPackage : bool
  - isActive : bool
  + calcPrice(weightKg) : decimal
}
class Staff {
  - id : int
  - fullName : string
  - role : StaffRole
  - specialty : string
  - photo : string
  - isActive : bool
  + isFree(startAt, endAt) : bool
}
class Appointment {
  - id : int
  - startAt : datetime
  - endAt : datetime
  - status : AppointmentStatus
  - note : string
  - source : string
  + confirm()
  + reschedule(newStart)
  + cancel()
  + complete()
  + markNoShow()
}
class Review {
  - id : int
  - rating : int
  - content : string
  - status : ReviewStatus
  + approve()
  + hide()
}
class GalleryItem {
  - id : int
  - imageBefore : string
  - imageAfter : string
  - hasConsent : bool
  - isVisible : bool
}
class User {
  - id : int
  - username : string
  - passwordHash : string
  - role : UserRole
  - lastLoginAt : datetime
  + login()
  + logout()
  + hasRole(role) : bool
}
class Notification {
  - id : int
  - channel : string
  - type : string
  - sentAt : datetime
  - status : string
  + send()
}

Customer "1" --> "0..*" Pet : nuôi
Customer "1" --> "0..*" Appointment : đặt
Pet "1" --> "0..*" Appointment : được chăm sóc
Service "1" --> "0..*" Appointment : thuộc về
Staff "1" --> "0..*" Appointment : thực hiện
Appointment "1" --> "0..1" Review : nhận
Appointment "1" --> "0..*" Notification : phát sinh
Pet "1" --> "0..*" GalleryItem : có ảnh
User "0..1" -- "0..1" Staff : tài khoản của
Appointment ..> AppointmentStatus
Review ..> ReviewStatus
Staff ..> StaffRole
User ..> UserRole
@enduml
